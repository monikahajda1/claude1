# ============================================================
#  USTAWIENIA APLIKACJI – wzór.
#  Skrypt start.bat przy pierwszym uruchomieniu sam tworzy z niego
#  plik ".env" i wpisuje losowe hasła. Plik .env NIE trafia do gita.
#  Przy przenosinach do chmury zmieniasz tylko .env – kodu nie trzeba ruszać.
# ============================================================

# Losowy, długi ciąg znaków (generowany automatycznie przez start.bat).
DJANGO_SECRET_KEY=ZMIEN_MNIE

# Tryb deweloperski: pokazuje szczegóły błędów. W normalnej pracy: False.
DJANGO_DEBUG=False

# Pod jakimi adresami aplikacja odpowiada (oddzielone przecinkami).
# Później dopiszesz tu nazwę komputera w Tailscale, np. biuro-pc.tail1234.ts.net
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Pełne adresy (z https://), z których wolno wysyłać formularze – potrzebne dla Tailscale/chmury.
# Przykład: https://biuro-pc.tail1234.ts.net
DJANGO_CSRF_TRUSTED_ORIGINS=

# Ustaw True, gdy aplikacja działa przez HTTPS (Tailscale serve albo chmura).
DJANGO_HTTPS=False

# --- Baza danych ---
POSTGRES_DB=posadzki
POSTGRES_USER=posadzki
# Hasło do bazy (generowane automatycznie przez start.bat).
POSTGRES_PASSWORD=ZMIEN_MNIE
# Serwer bazy: "db" to nazwa kontenera z bazą w docker-compose.
POSTGRES_HOST=db
# W chmurze zamiast powyższych można podać jeden adres:
# DATABASE_URL=postgres://uzytkownik:haslo@serwer:5432/posadzki

# Port, pod którym aplikacja będzie widoczna: http://localhost:8000
PORT=8000

# --- Ustawienia biznesowe ---
NAZWA_APLIKACJI=Posadzki – Budowy
ALERT_DNI_OSTRZEZENIE=30
ALERT_DNI_PILNE=7
